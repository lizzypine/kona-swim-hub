DEBUG=True
SECRET_KEY=replace-with-a-local-development-secret
DATABASE_URL=sqlite:////data/kona-swim-hub.sqlite3
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Inbound forwarding only. Set private values in .env.docker or Lightsail.
# Blank values leave the forwarding endpoint unavailable (HTTP 503).
RESEND_API_KEY=
EMAIL_FORWARD_TO=
RESEND_WEBHOOK_SECRET=
RESEND_INBOUND_ADDRESS=
